# WebTape needs no API keys and does not read .env files.
# The one optional setting is read by Playwright from the environment, so export it in your shell:
#   PowerShell: $env:PLAYWRIGHT_BROWSERS_PATH = "C:\path\to\browsers"
#   bash/zsh:   export PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers
# Where Chromium is downloaded and looked up (default: %LOCALAPPDATA%\ms-playwright on Windows).
# PLAYWRIGHT_BROWSERS_PATH=
